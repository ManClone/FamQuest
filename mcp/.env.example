# Separate MCP deployment; never commit .env or paste secrets into chat.
FAMQUEST_API_URL=http://app:8080
MCP_PUBLIC_URL=https://famquest.example.org
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Immutable GitHub numeric ID -> existing FamQuest parent USER ID (not member ID).
FAMQUEST_GITHUB_PARENTS={"66017797":1}
# Must match MCP_SERVICE_TOKEN in the FamQuest app environment.
FAMQUEST_SERVICE_TOKEN=
MCP_JWT_SIGNING_KEY=
# Fernet.generate_key(); persist unchanged across restarts.
MCP_STORAGE_ENCRYPTION_KEY=
